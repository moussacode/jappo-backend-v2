# Copier ce fichier en .env (non versionne) puis remplir les valeurs.
# Lignes "CLE=" : obligatoires. Lignes "# CLE=" : optionnelles, a decommenter
# seulement pour changer la valeur par defaut indiquee au-dessus.
# Ne jamais laisser une variable optionnelle decommentee et vide.

# Profil Spring : "dev" active le DataSeeder de demo. Jamais "dev" en production.
SPRING_PROFILES_ACTIVE=

# --- Base de donnees MySQL
# defaut : localhost
# DB_HOST=
# Serveur MySQL84 local (port defini dans C:\ProgramData\MySQL\MySQL Server 8.4\my.ini).
# Attention : le port 3306 est occupe par un autre serveur (MySQL80).
DB_PORT=3307
# defaut : jappo
# DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# defaut : true
# FLYWAY_ENABLED=

# --- Super-admin (mot de passe obligatoire : sinon l'application refuse de demarrer)
# defaut : admin@jappo.sn
# SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- JWT (secret Base64, 256 bits minimum ; expiration en ms, ex. 86400000)
JWT_SECRET=
JWT_EXPIRATION=

# --- URLs publiques
# defaut : http://localhost:4200
# APP_FRONTEND_URL=
# defaut : http://localhost:8080 (utilisee pour le callback PayDunya)
# APP_BACKEND_PUBLIC_URL=

# --- Mail SMTP Gmail (MAIL_PASSWORD = mot de passe d'application Gmail)
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Google Sign-In
GOOGLE_CLIENT_ID=

# --- Service IA jappo-ai (AI_API_KEY identique a celle de jappo-ai ; timeout en ms)
AI_ORCHESTRATOR_URL=
AI_API_KEY=
AI_TIMEOUT=

# --- LiveKit Cloud (visio). Host au format wss://<projet>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=

# --- PayDunya (sandbox)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# --- n8n (assistance) : desactive par defaut
# defaut : false
# N8N_ENABLED=
# defaut : http://localhost:5678
# N8N_BASE_URL=
